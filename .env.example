# Core App
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SITE_URL=https://www.hstuma.com
NEXT_PUBLIC_APP_URL=https://www.hstuma.com
NEXTAUTH_URL=https://www.hstuma.com
NEXTAUTH_SECRET=

# Multitenancy (org subdomains)
# - Tenant sites: <org>.p.hstuma.com
# - Main site: hstuma.com
TENANT_BASE_DOMAIN=p.hstuma.com
ROOT_DOMAIN=hstuma.com

# Auth / External Integrations
AUTH_SERVER_SERVICE_TOKEN=
JWT_SECRET=your-secure-jwt-secret-key-change-in-production-at-least-32-chars

# OAuth2 (Custom Auth Server)
# Used to hash auth codes + refresh tokens at rest. REQUIRED in production.
# Generate with e.g. `openssl rand -base64 48`.
OAUTH_TOKEN_HASH_PEPPER=

# Optional: mark certain clients as confidential by configuring a secret.
# If a client_id appears here, `/oauth2/token` will require client authentication
# (Basic auth or client_secret form field) for that client.
# Format: clientA=secretA,clientB=secretB
OAUTH_CLIENT_SECRETS=

OAUTH_REGISTERED_CLIENTS=dojo-app
AUTH_CANONICAL_ORIGIN=https://www.hstuma.com
EXTERNAL_AUTH_ALLOWED_ORIGINS=http://localhost:8081,https://hstuma.onrender.com,https://hstukarate.vercel.app,https://www.hstuma.com,https://hstuma.com

# Optional Services
SANITY_REVALIDATE_SECRET=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Vercel tenant subdomain management
VERCEL_PROJECT_ID=
VERCEL_API_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

CLOUDINARY_FOLDER=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
