    "name": "Kaizen Partner Admin",
    "slug": "kaizen-partner-admin",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "kaizenpartner",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.kaizenkarateacademy.partneradmin",
      "versionCode": 1,
      "permissions": []
