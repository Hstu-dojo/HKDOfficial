    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-build-properties",
      "expo-font"
    ],
    "extra": {
      "apiOrigin": "https://www.hstuma.com"
    }
  }
}
